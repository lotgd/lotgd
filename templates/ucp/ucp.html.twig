{% extends 'base.html.twig' %}

{% block body %}
    <div id="lotgd-ucp">
        <aside>
            <nav>
                <ul>
                    <li class="nav-item">
                        <a href="{{ path("lotgd_main") }}">Characters</a>
                    </li>

                    <li class="nav-head">Admin</li>

                    {% if is_granted("ROLE_ADMIN") %}
                        <li class="nav-item">
                            <a href="{{ path("lotgd_admin_settings") }}">Game Settings</a>
                        </li>
                    {% endif %}

                    {% if is_granted("ROLE_SCENE_EDITOR") %}
                        <li class="nav-item">
                            <a href="{{ path("lotgd_admin_scene") }}">Scenes</a>
                        </li>
                    {% endif %}
                </ul>
            </nav>
        </aside>

        <main>
            {{ component(component, props ?? {}) }}
        </main>
    </div>
{% endblock %}