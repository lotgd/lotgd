<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <title>{% block title %}Welcome!{% endblock %}</title>

        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
        {# Run `composer require symfony/webpack-encore-bundle` to start using Symfony UX #}
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>
    <body>
        <div id="lotgd-banner" class="@container/banner">
            <h1><a href="{{ url("lotgd_main") }}">Legend of the Green Dragon 2</a></h1>

            <nav>
                <ul>
                    <li>
                        <a href="{{ path("lotgd_main") }}">Home</a>
                    </li>
                </ul>
            </nav>
        </div>

        {% block body %}

        {% endblock %}

        <footer>
            <div class="footer-row">
                <div>
                    Design inspired by Chris Yarbrough
                </div>
                <div>

                </div>
                <div>
                    LotGD 2.0, check out on <a href="https://github.com/lotgd/lotgd">GitHub</a>
                </div>
            </div>
        </footer>
    </body>
</html>
