<div {{ attributes.defaults({}) }}>
    <div class="card">
        <div class="card-header">
            Fight!
        </div>

        <div class="card-body">
            <div class="flex justify-between border-b border-b-white pb-3">
                <div class="min-w-[200px]">
                    <strong>{{ battleState.goodGuy is instanceof("LotGD2\\Entity\\Battle\\CurrentCharacterFighter") ? "You" : battleState.goodGuy.name }}</strong>
                    <twig:Ui:Progress :max="battleState.goodGuy.maxHealth" :current="battleState.goodGuy.health" colored="true" displayCurrent="true" />
                </div>
                <div class="min-w-[200px]">
                    <strong>{{ battleState.badGuy.name }}</strong>, Level {{ battleState.badGuy.level }}
                    <twig:Ui:Progress :max="battleState.badGuy.maxHealth" :current="battleState.badGuy.health"  colored="true" displayCurrent="true" />
                </div>
            </div>

            <div class="row m-0 pb-3">
                {% set messageRounds = battleState.messageRounds %}
                {% set messageLength = messageRounds|length %}

                {% if messageLength > 3 %}
                    <details>
                        <summary>More</summary>

                        <dl class="m-0">
                            {% for round in messageRounds[:-3] %}
                                <dt>Round {{ round.round }}</dt>
                                {% for message in round.messages %}
                                    <dd>{{ message.message|parse(message.context, false)|raw }}</dd>
                                {% endfor %}
                            {% endfor %}
                        </dl>
                    </details>
                {% endif %}

                <dl class="m-0">
                    {% for round in messageRounds[-3:] %}
                        <dt>Round {{ round.round }}</dt>
                        {% for message in round.messages %}
                            <dd>{{ message.message|parse(message.context, false)|raw }}</dd>
                        {% endfor %}
                    {% endfor %}
                </dl>
            </div>
        </div>
    </div>
</div>