{%- block live_collection_widget -%}
    {%- if button_add is defined and not button_add.rendered -%}
        {{ form_row(button_add, { label: "+", attr: { class: 'btn btn-outline-primary' } }) }}
    {%- endif -%}

    <div class="form-collection">
        {{ block('form_widget') }}
    </div>
{% endblock %}

{%- block live_collection_entry_row -%}
    <div class="form-collection-entry">
        <div class="form-collection-entry-control">
            <div class="btn-group mb-3">
                {{- form_widget(button_delete, { label: 'X', attr: { class: 'btn btn-outline-danger' } }) -}}

                {%- if button_push_up is defined and not button_push_up.rendered -%}
                    {{- form_widget(button_push_up, { label: '↑', attr: { class: 'btn btn-outline-info' } }) -}}
                {%- endif -%}
                {%- if button_push_up is defined and not button_push_up.rendered -%}
                    {{- form_widget(button_push_down, { label: '↓', attr: { class: 'btn btn-outline-info' } }) -}}
                {%- endif -%}
            </div>
        </div>
        <div class="form-collection-entry-row">
            {% for key, child in form.children %}
                {{ form_row(child) }}
            {% endfor %}
        </div>
    </div>
{% endblock %}