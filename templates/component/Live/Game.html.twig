<div {{ attributes.defaults(
    stimulus_controller('tooltip'),
) }}>
    <!-- Loading  -->
    <div data-loading="show" class="loading">
        <div class="loading-text">Loading ...</div>
    </div>

    <div id="lotgd-game">
        <div id="lotgd-stage">
            <aside id="lotgd-actions">
                <nav>
                    <ul data-loading="hide">
                        {% if this.stage.actionGroups["lotgd.actionGroup.empty"] is defined %}
                            {% for action in this.stage.actionGroups["lotgd.actionGroup.empty"].actions %}
                                <twig:Action :action="action" :character="character" />
                            {% endfor %}
                        {% endif %}

                        {% for actionGroup in this.stage.actionGroups|filter(g => g.id not in ["lotgd.actionGroup.empty", "lotgd.actionGroup.hidden"])|sort((a, b) => a.weight <=> b.weight) %}
                            <li class="nav-head action-group">
                                {{ actionGroup.title }} {{ actionGroup.weight }}
                            </li>

                            {% for action in actionGroup.actions %}
                                <twig:Action :action="action" :character="character" />
                            {% endfor %}
                        {% endfor %}
                    </ul>
                </nav>
            </aside>

            <main>
                <h2>{{ this.stage.title }}</h2>

                {% for paragraph in this.stage.paragraphs %}
                    <twig:Paragraph :paragraph="paragraph" />
                {% endfor %}

                {# Attachments #}
                {% for attachment in this.stage.attachments %}
                    {% if is_granted("ROLE_DEBUG") and app.environment == "dev" %}
                        <twig:Debug title="Attachment" name="{{ attachment.attachment.name }}">
                            {# {{ dump(attachment) }} #}
                        </twig:Debug>
                    {% endif %}

                    {% try %}
                    {{ component(attachment.attachment.attachmentClass, {
                        "id": randomId(),
                        "character": character,
                        "stage": stage,
                        "config": attachment.config,
                    }|merge(attachment.data)) }}
                    {% catch %}
                        {% if is_granted("ROLE_DEBUG") %}
                            <twig:Debug title="Attachment" name="{{ attachment.attachment.name }}">
                                This attachment is faulty: {{ e.message }}

                                {% if app.environment == "dev" %}
                                    {# {{ dump(e) }} #}
                                {% endif %}
                            </twig:Debug>
                        {% endif %}
                    {% endcatch %}

                {% endfor %}
            </main>

            <aside class="lotgd-charstats">
                <div class="lotgd-mini-stats">
                    <div class="stats-portrait">
                        {# <img src="data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewport=%220 0 200 200%22><rect x=%220%22 y=%220%22 width=%22200%22 height=%22200%22 fill=%22#333333%22 /></svg>"> #}
                        <img src="data:image/svg+xml,{{
                            "<svg
                                xmlns='http://www.w3.org/2000/svg'
                                viewBox='0 0 128 128'>
                                <rect x='0' y='0' width='200' height='200' fill='black'></rect>
                            </svg>"|escape("html_attr")
                            }}">
                    </div>
                    <div class="stats-stats">
                        <div class="stats-bars">
                            <twig:Ui:Progress label="HP" :current="charStats.health[1]" :max="charStats.health[2]" barColor="danger" />
                            <twig:Ui:Progress label="TP" :current="charStats.turns[1]" :max="charStats.turns[2]" barColor="warning" />
                            <twig:Ui:Progress label="EP" :current="charStats.experience[1]" :max="charStats.experience[2]" barColor="info" />
                        </div>

                        <div class="stats-char">
                            <div>{{ charStats.name[1] }}</div>
                            <div class="stats-row">
                                <div id="lotgd-mini-stats-level" class="label">Level</div>
                                <div class="value" aria-labelledby="lotgd-mini-stats-level">{{ charStats.level[1] }}</div>
                            </div>
                            <div class="stats-row">
                                <div id="lotgd-mini-stats-race" class="label">Race</div>
                                <div class="value" aria-labelledby="lotgd-mini-stats-race">{{ charStats.race[1] }}</div>
                            </div>
                        </div>

                        <div class="stats-equipment">
                            <div class="stats-row">
                                <div id="lotgd-mini-stats-gold" class="label">Gold</div>
                                <div class="value" aria-labelledby="lotgd-mini-stats-gold">{{ charStats.gold[1] }}</div>
                            </div>

                            <div class="stats-row">
                                <div id="lotgd-mini-stats-wealth" class="label">Weapon</div>
                                <div class="value" aria-labelledby="lotgd-mini-stats-wealth">{{ charStats.weapon[1] }}</div>
                            </div>

                            <div class="stats-row">
                                <div id="lotgd-mini-stats-armor" class="label">Armor</div>
                                <div class="value" aria-labelledby="lotgd-mini-stats-armor">{{ charStats.armor[1] }}</div>
                            </div>
                        </div>
                    </div>
                </div>

                <table>
                    {% for row in charStats %}
                        {% if row|length == 1 %}
                            <tr>
                                <th scope="colgroup" colspan="2">{{ row[0] }}</th>
                            </tr>
                        {% else %}
                            <tr>
                                <th scope="row">{{ row[0] }}</th>
                                <td>
                                    {% if row|length == 2 %}
                                        {{ row[1] }}
                                    {% else %}
                                        <twig:Ui:Progress :current="row[1]" :max="row[2]" displayMax displayCurrent colored />
                                    {% endif %}
                                </td>
                            </tr>
                        {% endif %}
                    {% endfor %}
                </table>
            </aside>
        </div>
    </div>

    {#  <div class="d-flex">
        <div class="d-lg-none d-flex flex-column flex-shrink-0 bg-light sticky-top" style="width: 6rem;">
            <ul {{ stimulus_target("tooltip", "scrollSpy") }} id="lotgd-stage-nav" class="vh-100 nav nav-pills nav-flush flex-column mb-auto text-center rounded-0">
                <li class="nav-item">
                    <a href="#lotgd-stage-action" class="nav-link nav-flush flex-column border-bottom">Actions</a>
                </li>
                <li class="nav-item">
                    <a href="#lotgd-stage-scene" class="nav-link nav-flush flex-column border-bottom">Scene</a>
                </li>
                <li class="nav-item">
                    <a href="#lotgd-stage-character" class="nav-link nav-flush flex-column border-bottom">Stats</a>
                </li>
            </ul>
        </div>
    </div>#}
</div>