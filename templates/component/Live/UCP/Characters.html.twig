<div {{ attributes.defaults(stimulus_controller('modal', {

})) }}>
    {% set totalAvailableSlots = characterService.totalSlots %}
    {% set leftAvailableSlots = characterService.availableSlots %}
    {% set canAdd = leftAvailableSlots > 0 %}

    <div class="bg-body-tertiary rounded mb-3 p-2 d-flex justify-content-between">
        <button
                class="btn btn-primary {{ canAdd ?: "disabled" }}"
                {{ stimulus_action('modal', 'onNewClick') }}
        >Create new character</button>

        <div class="text-muted px-3">
            <small>Available Slots</small>
            <twig:Bootstrap:Progress
                    label="Character slots available"
                    min="0" max="{{ totalAvailableSlots }}"
                    current="{{ leftAvailableSlots }}"
                    displayMax="true"
                    displayCurrent="true"
            />
        </div>
    </div>

    <div class="row row-cols-1 row-cols-xl-2">
        {% for character in characters %}
            <div class="col mb-3" id="lotgd-entity-character-{{ character.id }}">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-start">
                        {{ character.name }} <span class="badge bg-primary">{{ character.level }}</span>
                    </div>

                    <div class="card-body">
                        <h5 class="card-title">{{ character.title }}</h5>
                        <p class="card-text">A character</p>

                        <a href="{{ path("lotgd_game_stage", {"character": character.id}) }}" class="btn btn-primary">Play</a>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    <div {{ stimulus_target("modal", "modal") }} class="modal" tabindex="-1">
        <div class="modal-dialog modal-lg small">
            <div class="modal-content">
                {% if character %}
                    <twig:User:CharacterForm :key="character.id" :entity="character" new="0" />
                {% else %}
                    <twig:User:CharacterForm key="new" :entity="character" new="1" />
                {% endif %}
            </div>
        </div>
    </div>
</div>
