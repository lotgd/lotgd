<div {{ attributes.defaults(stimulus_controller('admin/scene', {
    tree: tree,
    class: "component",
})|stimulus_controller('modal')) }}>
    <div {{ stimulus_target('admin/scene', "sceneView") }}
            id=""
            class="bg-white rounded-xl mt-3"
    >

    </div>

    <dialog {{ stimulus_target("admin/scene", "modal")|stimulus_target("modal", "modal") }} class="modal" tabindex="-1">
        <div class="modal-content">
            {% if scene %}
                <twig:Admin:SceneForm :key="scene.id" :scene="scene" />
            {% else %}
                <twig:Admin:SceneForm key="new" :scene="scene" :parentScene="parentScene" />
            {% endif %}
        </div>
    </dialog>

    <dialog {{ stimulus_target("admin/scene", "sceneConnectionModal")|stimulus_target("modal", "modal") }} class="modal" tabindex="-1">
        <div class="modal-content">
            {% if sceneConnection %}
                <twig:Admin:SceneConnectionForm :key="sceneConnection.id" :sceneConnection="sceneConnection" />
            {% endif %}
        </div>
    </dialog>
</div>