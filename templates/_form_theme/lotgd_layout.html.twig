{%- block form_row -%}
    <div class="form-grid">
        <div class="col-label">
            {{ form_label(form) }}
        </div>
        <div class="col-input">
            {{ form_help(form) }}
            {{ form_errors(form) }}
            {{ form_widget(form) }}
        </div>
    </div>
{%- endblock -%}

{% block grouped_form_row %}
    <div class="form-grid">
        <div class="col-label">
            {{ form_label(form) }}
        </div>
        <div class="col-input">
            {{ form_errors(form) }}
            {{ form_widget(form) }}
            {{ form_help(form) }}
        </div>
    </div>
{% endblock %}

{% block tabbed_row %}
    <div class="tabs"
         {{ stimulus_controller("form/TabbedForm") }}
    >
        {% set tabs = [] %}
        {% for child in form %}
            {% if "grouped_form" in child.vars.block_prefixes %}
                {% set tabs = tabs|merge([{
                    id: child.vars.id,
                    label: child.vars.label ?? child.vars.name|humanize,
                    child: child,
                }]) %}
            {% endif %}
        {% endfor %}

        <div class="tab-nav">
            <ul>
                {%- for tab in tabs -%}
                    <li
                            class="nav-item {{ loop.index0 == 0 ? "active" : "" }}"
                            {{ stimulus_target("form/TabbedForm", "tabNav") }}
                            {{ stimulus_action("form/TabbedForm", "toggle", "click") }}
                            data-tab-id="lotgd-tab-{{ tab.id }}"
                    >
                        <a class="nav-link"
                           {{ loop.index0 == 0 ? 'aria-current="page"' }}
                        >{{ tab.label|raw }}</a>
                    </li>
                {%- endfor -%}
            </ul>
        </div>

        <div class="tab-body">
            <div class="tab-content tab-content-vertical">
                {%- for tab in tabs -%}
                <div class="tab-pane fade {{ loop.index0 == 0 ? "show active" : "" }}"
                     id="lotgd-tab-{{ tab.id }}"
                     {{ stimulus_target("form/TabbedForm", "tab") }}
                >
                    <h3 class="mx-3">
                        {{ form_label(tab.child) }}
                    </h3>
                    <div class="text-muted mx-3">
                        {{ form_help(tab.child) }}
                    </div>
                    <div class="text-danger mx-3">
                        {{ form_errors(tab.child) }}
                    </div>
                    <div class="mx-3 mt-3">
                        {{ form_widget(tab.child) }}
                    </div>
                </div>
                {%- endfor -%}
            </div>
        </div>
    </div>

    <div class="mt-3">
        {{ form_rest(form) }}
    </div>
{% endblock %}

{% block chance_widget %}
    <div class="input-group mb-3">
        {{ form_widget(form.numerator) }}
        <span class="input-group-text">in</span>
        {{ form_widget(form.denominator) }}
    </div>
{% endblock %}

{% block valueRange_widget %}
    <div class="input-group mb-3">
        {{ form_widget(form.minimum) }}
        <span class="input-group-text">–</span>
        {{ form_widget(form.maximum) }}
    </div>
{% endblock %}

{% block character_expression_widget %}
    <div class="small">Probable lower extreme: <strong>{{ minimumValue }}</strong>, upper extreme: <strong>{{ maximumValue }}</strong></div>
    <div {{ stimulus_controller('form/CharacterExpressionType', {
        validVariables: objectNamespace,
        variableNamespace: namespace,
    }) }}>
        <div
                class="hidden"
                {{ stimulus_target('form/CharacterExpressionType', 'widget') }}>{{ form_widget(form) }}</div>
        <div
                data-live-ignore
                class="input"
                {{ stimulus_target('form/CharacterExpressionType', 'editor') }}
        ></div>
        <div class="input-group">
            <div class="input-group-text">
                Variables
            </div>
            <select data-live-ignore class="form-control" {{ stimulus_target('form/CharacterExpressionType', 'variableSelection') }}></select>
            <button class="form-control" {{ stimulus_action('form/CharacterExpressionType', 'insertVariable') }} type="button">Insert</button>
        </div>
    </div>
{% endblock %}

{%- block form_errors -%}
    {%- if errors|length > 0 -%}
        <div class="alert alert-danger mb-2">
            <ul>
                {%- for error in errors -%}
                    <li class="{{ error_item_class|default('') }}" id="{{ id ~ '_error' ~ loop.index }}">{{ error.message }}</li>
                {%- endfor -%}
            </ul>
        </div>
    {%- endif -%}
{%- endblock form_errors -%}

{%- block checkbox_row -%}
    {%- set row_attr = row_attr|merge({class: row_attr.class|default(row_class|default('mb-6'))}) -%}
    {%- set widget_attr = {} -%}
    {%- if help -%}
        {%- set widget_attr = {attr: {'aria-describedby': id ~ '_help'}} -%}
    {%- endif -%}

    <div class="form-grid" {% with {attr: row_attr} %}{{ block('attributes') }}{% endwith %}>
        <div class="col-label">
        </div>
        <div class="col-input">
            {{ form_help(form) }}
            {{- form_errors(form) -}}

            <div class="inline-flex items-center">
                {{- form_widget(form, widget_attr) -}}
                {{- form_label(form) -}}
            </div>
        </div>
    </div>
{%- endblock checkbox_row -%}