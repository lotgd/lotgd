{% block form_row %}
<div class="row mb-3 pb-3">
    <div class="col col-4">
        {{ form_label(form) }}
    </div>
    <div class="col col-8">
        {{ form_errors(form) }}
        {{ form_widget(form) }}
        {{ form_help(form) }}
    </div>
</div>
{% endblock %}

{% block grouped_form_row %}
    <div class="row mb-3 pb-3 outset border-5">
        <div class="col col-4">
            {{ form_label(form) }}
        </div>
        <div class="col col-8">
            {{ form_errors(form) }}
            {{ form_widget(form) }}
            {{ form_help(form) }}
        </div>
    </div>
{% endblock %}

{% block tabbed_row %}
    <div class="row">
        {% set tabs = [] %}
        {% for child in form %}
            {% if "grouped_form" in child.vars.block_prefixes %}
                {% set tabs = tabs|merge([{
                    id: child.vars.id,
                    label: child.vars.label ?? child.vars.name|humanize,
                    child: child,
                }]) %}
            {% endif %}
        {% endfor %}

        <div class="col-4 col-lg-3 col-xl-5 col-xxl-2 p-0">
            <ul class="nav nav-tabs flex-column tabs-vertical">
                {%- for tab in tabs -%}
                    <li class="nav-item">
                        <a class="nav-link {{ loop.index0 == 0 ? "active" : "" }}"
                           data-bs-toggle="tab" data-bs-target="#lotgd-tab-{{ tab.id }}"
                           {{ loop.index0 == 0 ? 'aria-current="page"' }}
                        >{{ tab.label|raw }}</a>
                    </li>
                {%- endfor -%}
            </ul>
        </div>
        <div class="col-6 col-lg-9 col-xl-7 col-xxl-10 p-0">
            <div class="tab-content tab-content-vertical">
                {%- for tab in tabs -%}
                <div class="tab-pane fade {{ loop.index0 == 0 ? "show active" : "" }}"
                     id="lotgd-tab-{{ tab.id }}"
                >
                    <h3 class="mx-3">
                        {{ form_label(tab.child) }}
                    </h3>
                    <div class="text-muted mx-3">
                        {{ form_help(tab.child) }}
                    </div>
                    <div class="text-danger mx-3">
                        {{ form_errors(tab.child) }}
                    </div>
                    <div class="mx-3 mt-3">
                        {{ form_widget(tab.child) }}
                    </div>
                </div>
                {%- endfor -%}
            </div>
        </div>

        <div class="mt-3">
            {{ form_rest(form) }}
        </div>
    </div>
{% endblock %}

{% block chance_widget %}
    <div class="input-group mb-3">
        {{ form_widget(form.numerator) }}
        <span class="input-group-text">in</span>
        {{ form_widget(form.denominator) }}
    </div>
{% endblock %}

{% block valueRange_widget %}
    <div class="input-group mb-3">
        {{ form_widget(form.minimum) }}
        <span class="input-group-text">–</span>
        {{ form_widget(form.maximum) }}
    </div>
{% endblock %}

{% block character_expression_widget %}
    <div class="small">Probable lower extreme: <strong>{{ minimumValue }}</strong>, upper extreme: <strong>{{ maximumValue }}</strong></div>
    <div {{ stimulus_controller('form/CharacterExpressionType', {
        validVariables: objectNamespace,
        variableNamespace: namespace,
    }) }}>
        <div
                class="d-none"
                {{ stimulus_target('form/CharacterExpressionType', 'widget') }}>{{ form_widget(form) }}</div>
        <div
                data-live-ignore
                {{ stimulus_target('form/CharacterExpressionType', 'editor') }}
        ></div>
        <div class="input-group">
            <div class="input-group-text">
                Variables
            </div>
            <select data-live-ignore class="form-control" {{ stimulus_target('form/CharacterExpressionType', 'variableSelection') }}></select>
            <button class="form-control" {{ stimulus_action('form/CharacterExpressionType', 'insertVariable') }} type="button">Insert</button>
        </div>
    </div>
{% endblock %}