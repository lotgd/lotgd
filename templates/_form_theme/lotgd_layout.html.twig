{% block grouped_form_row %}
<div class="mb-3">
    <div class="border-start border-5">
        <div class="pb-3 mb-3">
            <h2 class="bg-body-tertiary ps-3 h6 text-body-emphasis">{{ form_label(form, null, {
                    "label_attr": {"class": "float-none"},
                }) }}</h2>

            <div class="ps-3">
                {{ form_help(form) }}
                {{ form_errors(form) }}
            </div>
        </div>

        <div class="ps-3">
            {% for child in form.children|filter(child => not child.rendered) %}
                {{ form_row(child) }}
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}

{% block chance_widget %}
    <div class="input-group mb-3">
        {{ form_widget(form.numerator) }}
        <span class="input-group-text">in</span>
        {{ form_widget(form.denominator) }}
    </div>
{% endblock %}

{% block valueRange_widget %}
    <div class="input-group mb-3">
        {{ form_widget(form.minimum) }}
        <span class="input-group-text">–</span>
        {{ form_widget(form.maximum) }}
    </div>
{% endblock %}

{% block character_expression_widget %}
    <div class="small">Probable lower extreme: <strong>{{ minimumValue }}</strong>, upper extreme: <strong>{{ maximumValue }}</strong></div>
    <div {{ stimulus_controller('form/CharacterExpressionType', {
        validVariables: objectNamespace,
        variableNamespace: namespace,
    }) }}>
        <div
                class="d-none"
                {{ stimulus_target('form/CharacterExpressionType', 'widget') }}>{{ form_widget(form) }}</div>
        <div
                data-live-ignore
                {{ stimulus_target('form/CharacterExpressionType', 'editor') }}
        ></div>
        <div class="input-group">
            <div class="input-group-text">
                Variables
            </div>
            <select data-live-ignore class="form-control" {{ stimulus_target('form/CharacterExpressionType', 'variableSelection') }}></select>
            <button class="form-control" {{ stimulus_action('form/CharacterExpressionType', 'insertVariable') }} type="button">Insert</button>
        </div>
    </div>
{% endblock %}